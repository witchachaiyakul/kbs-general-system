rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function validStatus(status) {
      return status in ['รออนุมัติ', 'อนุมัติ', 'ไม่อนุมัติ'];
    }

    function validBooking() {
      return request.resource.data.keys().hasAll([
          'fullName', 'phone', 'location', 'purpose',
          'startTime', 'endTime', 'equipment', 'tables', 'chairs', 'status',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'fullName', 'position', 'positionOther', 'pos', 'phone', 'location', 'purpose',
          'startTime', 'endTime', 'equipment', 'tables', 'chairs', 'status',
          'line_user_id', 'placeId', 'bookingNo', 'attendees',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.location is string
        && request.resource.data.location.size() > 0
        && request.resource.data.purpose is string
        && request.resource.data.purpose.size() > 0
        && (!('attendees' in request.resource.data) || (request.resource.data.attendees is int && request.resource.data.attendees >= 0))
        && request.resource.data.startTime is timestamp
        && request.resource.data.endTime is timestamp
        && request.resource.data.endTime > request.resource.data.startTime
        && request.resource.data.equipment is list
        && request.resource.data.tables is int
        && request.resource.data.tables >= 0
        && request.resource.data.chairs is int
        && request.resource.data.chairs >= 0
        && request.resource.data.status == 'รออนุมัติ'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function matchingPublicBooking(bookingId) {
      let publicBooking = getAfter(/databases/$(database)/documents/publicBookings/$(bookingId)).data;
      return publicBooking.bookingId == bookingId
        && publicBooking.fullName == request.resource.data.fullName
        && publicBooking.location == request.resource.data.location
        && publicBooking.startTime == request.resource.data.startTime
        && publicBooking.endTime == request.resource.data.endTime
        && publicBooking.status == request.resource.data.status;
    }

    function matchingPrivateBooking(bookingId) {
      let booking = getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data;
      return booking.fullName == request.resource.data.fullName
        && booking.location == request.resource.data.location
        && booking.startTime == request.resource.data.startTime
        && booking.endTime == request.resource.data.endTime
        && booking.status == request.resource.data.status;
    }

    match /bookings/{bookingId} {
      allow create: if validBooking() && matchingPublicBooking(bookingId);
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && validStatus(request.resource.data.status)
        && request.resource.data.updatedAt == request.time
        && matchingPublicBooking(bookingId);
      allow delete: if false;
    }

    match /publicBookings/{bookingId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll([
          'bookingId', 'fullName', 'location', 'startTime', 'endTime', 'status',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'bookingId', 'bookingNo', 'fullName', 'pos', 'placeId', 'location', 'purpose', 'attendees', 'startTime', 'endTime', 'status',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.bookingId == bookingId
        && request.resource.data.fullName is string
        && request.resource.data.location is string
        && request.resource.data.startTime is timestamp
        && request.resource.data.endTime is timestamp
        && request.resource.data.endTime > request.resource.data.startTime
        && request.resource.data.status == 'รออนุมัติ'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && matchingPrivateBooking(bookingId);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && validStatus(request.resource.data.status)
        && request.resource.data.updatedAt == request.time
        && matchingPrivateBooking(bookingId);
      allow delete: if false;
    }

    // ตัวนับลำดับเอกสาร/เลขอ้างอิง (Counters เช่น room_booking, fix_report)
    match /counters/{counterId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    // สิทธิ์อ่านรายการสถานที่/ห้องประชุม
    match /kbs_place/{placeId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /places/{placeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // สิทธิ์อ่านข้อมูลทะเบียนบุคลากร/สิทธิ์
    match /committees/{committeeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // บันทึก Audit Logs
    match /audit_logs/{logId} {
      allow create: if true;
      allow read: if isAdmin();
    }
  }
}
