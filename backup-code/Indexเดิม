  function renderLineUI() {
    const d = lineConfigData;
   document.getElementById('line-quota-max').value = d.quotaMax; document.getElementById('line-members').value = d.members;
    let totalSends = Math.floor(d.quotaMax / (d.members || 1)); let remainSends = totalSends - d.sendsCount;
   document.getElementById('line-quota-display').innerText = `ส่งได้ทั้งหมด: ${totalSends} ครั้ง | ส่งไปแล้ว: ${d.sendsCount} | คงเหลือ: ${remainSends} ครั้ง`;
    if(remainSends <= 5) document.getElementById('line-quota-display').classList.replace('bg-primary', 'bg-danger'); else document.getElementById('line-quota-display').classList.replace('bg-danger', 'bg-primary');
    
   document.getElementById('line-group-id').value = d.groupId;
    let tbody = document.getElementById('line-bots-tbody'); tbody.innerHTML = '';
    d.bots.forEach(b => { let isChecked = (b.id === d.activeBotId) ? 'checked' : ''; tbody.innerHTML += `<tr><td class="text-center"><input class="form-check-input fs-4" type="radio" name="activeBot" value="${b.id}" ${isChecked}></td><td class="fw-bold">Bot ${b.id}</td><td><input type="text" class="form-control bot-basic" data-id="${b.id}" value="${b.basicId}"></td><td><input type="text" class="form-control bot-token" data-id="${b.id}" value="${b.token}"></td></tr>`; });
 
    let triggerTbody = document.getElementById('line-triggers-tbody'); triggerTbody.innerHTML = '';
    if(!d.triggers || d.triggers.length === 0) { 
        triggerTbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted">ยังไม่มีการตั้งเวลาแจ้งเตือน</td></tr>';
    } else { 
       d.triggers.forEach(t => { 
            let freqText = "";
           if(t.freqType === 'daily') freqText = '<span class="badge bg-primary">ทุกวัน</span>';
            else if(t.freqType === 'weekly') freqText = `<span class="badge bg-info text-dark">ทุกวัน${dayNamesList[t.freqValue]}</span>`;
            else if(t.freqType === 'specific_date') {
                let parts = t.freqValue.split('-'); 
                let thDate = `${parts[2]}/${parts[1]}/${parseInt(parts[0])+543}`;
               freqText = `<span class="badge bg-warning text-dark">วันที่ ${thDate}</span>`;
            }
            let rangeText = "";
           if(t.rangeType === 'today') rangeText = 'สรุป "วันนี้"';
            else if(t.rangeType === 'tomorrow') rangeText = 'สรุป "พรุ่งนี้"';
            else if(t.rangeType === '7days') rangeText = 'สรุป "7 วันล่วงหน้า"';
            else if(t.rangeType === 'custom') {
                let sP = t.rangeStart.split('-'); let eP = t.rangeEnd.split('-');
               rangeText = `กำหนดเอง<br><small class="text-muted">(${sP[2]}/${sP[1]} - ${eP[2]}/${eP[1]})</small>`;
            }
           triggerTbody.innerHTML += `<tr><td>${freqText}</td><td>${rangeText}</td><td class="fw-bold text-success">${t.time} น.</td><td class="text-center text-nowrap"><button class="btn btn-sm btn-outline-primary test-trigger-btn" data-id="${t.id}" title="ทดสอบส่งเดี๋ยวนี้"><i class="fas fa-rocket"></i></button> <button class="btn btn-sm btn-warning edit-trigger-btn" data-id="${t.id}"><i class="fas fa-edit"></i></button> <button class="btn btn-sm btn-danger delete-trigger-btn" data-id="${t.id}"><i class="fas fa-trash"></i></button></td></tr>`; 
        }); 
    }
  }
   
 document.getElementById('trigger-freq-type').addEventListener('change', function() {
      let val = this.value; let container = document.getElementById('freq-value-container'); let weekly = document.getElementById('trigger-freq-weekly'); let date = document.getElementById('trigger-freq-date');
      if(val === 'daily') { container.style.display = 'none'; weekly.removeAttribute('required'); date.removeAttribute('required'); }
      else if(val === 'weekly') { container.style.display = 'block'; weekly.style.display = 'block'; date.style.display = 'none'; weekly.setAttribute('required','true'); date.removeAttribute('required'); }
      else if(val === 'specific_date') { container.style.display = 'block'; weekly.style.display = 'none'; date.style.display = 'block'; date.setAttribute('required','true'); weekly.removeAttribute('required'); }
  });
   
