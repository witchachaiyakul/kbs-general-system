 document.getElementById('trigger-submit-form').addEventListener('submit', function(e) { e.preventDefault(); showLoading(true, "กำลังบันทึก..."); let tid = document.getElementById('trigger-id').value; let newTriggers = [...(lineConfigData.triggers || [])]; let fType = document.getElementById('trigger-freq-type').value; let fVal = ""; if(fType === 'weekly') fVal = document.getElementById('trigger-freq-weekly').value; else if(fType === 'specific_date') fVal = document.getElementById('trigger-freq-date').value; let rType = document.getElementById('trigger-range-type').value; let rStart = ""; let rEnd = ""; if(rType === 'custom') { rStart = document.getElementById('trigger-range-start').value; rEnd = document.getElementById('trigger-range-end').value; if(new Date(rEnd) < new Date(rStart)) { Swal.fire('ข้อผิดพลาด', 'วันที่สิ้นสุดต้องไม่น้อยกว่าวันที่เริ่มต้น', 'error'); return; } } let tData = { id: tid || Date.now().toString(), freqType: fType, freqValue: fVal, rangeType: rType, rangeStart: rStart, rangeEnd: rEnd, time: document.getElementById('trigger-time').value, msg: document.getElementById('trigger-msg').value }; if(tid) { let idx = newTriggers.findIndex(x => x.id == tid); if(idx > -1) newTriggers[idx] = tData; } else { newTriggers.push(tData); } showLoading(true, "กำลังบันทึก..."); google.script.run.withSuccessHandler(res => { triggerModalInstance.hide(); lineConfigData = res.settings; renderLineUI(); showLoading(false); Swal.fire('สำเร็จ', 'บันทึกการตั้งเวลาเรียบร้อย', 'success'); }).saveLineSettingsData({ type: 'triggers', triggers: newTriggers }, currentAdminName); });
