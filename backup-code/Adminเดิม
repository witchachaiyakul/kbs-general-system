            <div class="card-body">
              
              <form id="blockout-form" class="row g-3 align-items-end">
                <div class="col-md-4">
                  <label for="block-room-select" class="form-label fw-bold">เลือกห้องที่ต้องการปิด</label>
                  <div class="input-group">
                    <select id="block-room-select" class="form-select" required>
                      <option value="ALL_ROOMS" selected>--- ปิดทุกห้อง ---</option>
                    </select>
                    <button class="btn btn-primary fw-bold" type="button" onclick="emergencyFetchRooms()" title="โหลดรายชื่อห้องใหม่">🔄 โหลด</button>
                  </div>
                  
                  <script>
                    function emergencyFetchRooms() {
                      var ddl = document.getElementById('block-room-select');
                      if(!ddl) return;
                      ddl.innerHTML = '<option value="ALL_ROOMS">⏳ โหลด...</option>';
                      
                      google.script.run.withSuccessHandler(function(res) {
                        ddl.innerHTML = '<option value="ALL_ROOMS" selected>--- ปิดทุกห้อง ---</option>';
                        if(res && res.length > 0) {
                          res.forEach(function(r) {
                            var rName = typeof r === 'object' ? (r.name || r.ID || r[0]) : r;
                            if(rName && rName !== 'ID' && rName !== 'RoomName' && rName !== 'ความจุ (คน)') {
                              var opt = document.createElement('option');
                              opt.value = rName;
                              opt.text = rName;
                              ddl.appendChild(opt);
                            }
                          });
                        }
                      }).withFailureHandler(function(err) {
                        alert("แจ้งเตือน Error จากเซิร์ฟเวอร์: " + err.message);
                        ddl.innerHTML = '<option value="ALL_ROOMS" selected>--- ขัดข้อง ---</option>';
                      }).getRoomsData();
                    }
                    // สั่งให้ดึงอัตโนมัติ 1 รอบตอนโหลดหน้า
                    setTimeout(emergencyFetchRooms, 1500);
                  </script>
