function getChartData(startStr, endStr) {
  try {
    const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(SHEET_NAME);
    if (sheet.getLastRow() < 2) return { rooms: {}, statuses: {}, recent: [] };
    const values = sheet.getRange(2, 1, sheet.getLastRow() - 1, sheet.getLastColumn()).getValues();
    let filterStart = startStr ? new Date(startStr).getTime() : 0;
    let filterEnd = endStr ? new Date(endStr).setHours(23,59,59,999) : Infinity;
    let roomCounts = {}; let statusCounts = { 'อนุมัติ': 0, 'รออนุมัติ': 0, 'ไม่อนุมัติ': 0, 'จัดสถานที่แล้ว': 0 }; let recentBookings = [];
    for (let i = values.length - 1; i >= 0; i--) {
      const row = values[i];
      if (!row[6]) continue;
      let bTime = new Date(row[6]).getTime();
      if (bTime >= filterStart && bTime <= filterEnd) {
        let room = row[4] || 'ไม่ระบุ'; let status = row[13] || 'รออนุมัติ';
        roomCounts[room] = (roomCounts[room] || 0) + 1;
        if (statusCounts[status] !== undefined) statusCounts[status]++;
        if (recentBookings.length < 10) recentBookings.push({ fullName: row[1], location: room, startTime: new Date(row[6]).toISOString(), status: status });
      }
    }
    return { rooms: roomCounts, statuses: statusCounts, recent: recentBookings };
  } catch(e) { return { rooms: {}, statuses: {}, recent: [] }; }
}

