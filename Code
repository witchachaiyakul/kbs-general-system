}

function executeLineSummary(t, config) {
  var today = new Date();
  var targetMonday, targetSunday;

  // 🟢 ลอกโครงสร้างคำนวณช่วงสัปดาห์แบบดั้งเดิมของคุณมาใช้แบบ 100%
  if (t.rangeType === '7days') {
    var dayOfWeek = today.getDay(); 
    var offsetToMonday = (dayOfWeek === 0) ? -6 : 1 - dayOfWeek;
    if (dayOfWeek === 5 || dayOfWeek === 6 || dayOfWeek === 0) { offsetToMonday += 7; }
    
    targetMonday = new Date(today.getFullYear(), today.getMonth(), today.getDate() + offsetToMonday);
    targetMonday.setHours(0, 0, 0, 0);
    
    targetSunday = new Date(targetMonday.getTime());
    targetSunday.setDate(targetMonday.getDate() + 6);
    targetSunday.setHours(23, 59, 59, 999);
  } else if (t.rangeType === 'tomorrow') {
    targetMonday = new Date();
    targetMonday.setDate(targetMonday.getDate() + 1);
    targetMonday.setHours(0, 0, 0, 0);
    targetSunday = new Date(targetMonday);
    targetSunday.setHours(23, 59, 59, 999);
  } else if (t.rangeType === 'custom' && t.rangeStart && t.rangeEnd) {
    targetMonday = new Date(t.rangeStart);
    targetMonday.setHours(0, 0, 0, 0);
    targetSunday = new Date(t.rangeEnd);
    targetSunday.setHours(23, 59, 59, 999);
  } else {
    targetMonday = new Date();
    targetMonday.setHours(0, 0, 0, 0);
    targetSunday = new Date(targetMonday);
    targetSunday.setHours(23, 59, 59, 999);
  }

  var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("data");
  var sheetData = sheet.getDataRange().getValues();

  function formatDateLocal(date) { return Utilities.formatDate(date, 'Asia/Bangkok', 'dd/MM/yyyy'); }
  function formatTimeLocal(date) { return Utilities.formatDate(date, 'Asia/Bangkok', 'HH:mm'); }
  var thaiDays = ['อาทิตย์', 'จันทร์', 'อังคาร', 'พุธ', 'พฤหัสบดี', 'ศุกร์', 'เสาร์'];

  var messageHeader = '🗓️ สรุปตารางใช้ห้องประชุม\n(' + formatDateLocal(targetMonday) + ' - ' + formatDateLocal(targetSunday) + '):\n';
  var messageBody = '';
  var upcomingUsage = [];

  // 🟢 วนลูปและตรวจจับวันที่ด้วยคำสั่งดั้งเดิมของคุณที่ระบบอ่านค่าได้เสถียรที่สุด
  for (var i = 1; i < sheetData.length; i++) {
    var row = sheetData[i];
    if (!row[6]) continue;
    
    var startTime = new Date(row[6]);
    if (startTime.toString() === "Invalid Date") continue;

    // 🟢 เปรียบเทียบช่วงเวลาตรงๆ แบบโค้ดเดิม และไม่สนใจตัวกรองสถานะใดๆ ตามคำสั่ง
    if (startTime >= targetMonday && startTime <= targetSunday) {
      upcomingUsage.push({ startTime: startTime, endTime: new Date(row[7]), location: row[4], fullName: row[1] });
    }
  }

  upcomingUsage.sort(function(a, b) { return a.startTime - b.startTime; });

  if (upcomingUsage.length === 0) { 
    messageBody = '\nไม่มีการใช้ห้องในช่วงเวลาดังกล่าว'; 
  } else {
    upcomingUsage.forEach(function(usage, index) {
      messageBody += '\n' + (index > 0 ? '----------\n' : '');
      messageBody += 'ห้อง: ' + usage.location + '\nวัน: ' + formatDateLocal(usage.startTime) + ' (' + thaiDays[usage.startTime.getDay()] + ')\nเวลา: ' + formatTimeLocal(usage.startTime) + ' - ' + formatTimeLocal(usage.endTime) + '\nผู้ใช้: ' + usage.fullName;
    });
  }

  var finalMessage = messageHeader + messageBody;
  if (t.msg && t.msg.trim() !== '') finalMessage += '\n\n' + t.msg;

  // ส่งข้อความเข้า LINE กลุ่มตาม Bot ที่เลือกใช้งานปัจจุบัน
  var bot = config.bots.find(function(b) { return b.id == config.activeBotId; }) || config.bots[0];
  if (bot && config.groupId) {
    var payload = { "to": config.groupId.trim(), "messages": [{ "type": "text", "text": finalMessage }] };
    var options = {
      "method": "post",
      "headers": { "Authorization": "Bearer " + bot.token.trim(), "Content-Type": "application/json" },
      "payload": JSON.stringify(payload),
      "muteHttpExceptions": true
    };
    UrlFetchApp.fetch("https://api.line.me/v2/bot/message/push", options);
  }
}

