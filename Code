function isTimeBlocked(startTime, endTime, roomName) {
  const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(BLOCKED_SHEET_NAME);
  if (sheet.getLastRow() < 2) return false;
  const data = sheet.getRange(2, 1, sheet.getLastRow() - 1, sheet.getLastColumn()).getValues();
  const checkStart = new Date(startTime).getTime(), checkEnd = new Date(endTime).getTime();
  let cleanRoom = roomName;
  if (typeof cleanRoom === 'string' && cleanRoom.includes(' รองรับ')) cleanRoom = cleanRoom.split(' รองรับ')[0].trim();
  else if (typeof cleanRoom === 'string') cleanRoom = cleanRoom.trim();
  
  for (let i = 0; i < data.length; i++) {
    const bStart = new Date(data[i][1]).getTime(), bEnd = new Date(data[i][2]).getTime();
    let bRoom = data[i][3];
    if (typeof bRoom === 'string' && bRoom.includes(' รองรับ')) bRoom = bRoom.split(' รองรับ')[0].trim();
    else if (typeof bRoom === 'string') bRoom = bRoom.trim();
    if (checkStart < bEnd && checkEnd > bStart) {
      if (bRoom === 'ALL_ROOMS' || bRoom === 'ทุกห้อง' || bRoom === cleanRoom) return true;
    }
  }
  return false;
}

