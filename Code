function processLineMessage(messageText) {
  const settings = getLineSettings();
  const activeBot = settings.bots.find(b => b.id === settings.activeBotId) || settings.bots[0];
  const totalAllowedSends = Math.floor(settings.quotaMax / (settings.members || 1));
  let remainingSends = totalAllowedSends - settings.sendsCount;
  
  if (remainingSends <= 5 && remainingSends > 0) {
    messageText += `\n\n⚠️ คำเตือน: โควตา LINE ของเดือนนี้ใกล้หมดแล้ว (เหลือส่งได้อีก ${remainingSends-1} ครั้ง)\nกรุณาเตรียมสลับ Bot`;
  } else if (remainingSends <= 0) {
    messageText += `\n\n❌ คำเตือน: โควตา LINE หมดแล้ว ข้อความอาจไม่ถึงผู้รับ กรุณาสลับ Botทันที`;
  }
  
  const url = 'https://api.line.me/v2/bot/message/push';
  const payload = { to: settings.groupId, messages: [{ type: 'text', text: messageText }] };
  const options = { method: 'post', contentType: 'application/json', headers: { Authorization: 'Bearer ' + activeBot.token }, payload: JSON.stringify(payload), muteHttpExceptions: true };
  UrlFetchApp.fetch(url, options);
  
  PropertiesService.getScriptProperties().setProperty('line_sends_count', (settings.sendsCount + 1).toString());
}

