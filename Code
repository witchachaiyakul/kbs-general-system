function processSmartLineTriggers() {
  var config = getLineSettings();
  if (!config || !config.triggers || config.triggers.length === 0) return;
  
  var now = new Date();
  var currentHourMin = Utilities.formatDate(now, "Asia/Bangkok", "HH:mm");
  var currentDayOfWeek = now.getDay().toString();
  var currentDate = Utilities.formatDate(now, "Asia/Bangkok", "yyyy-MM-dd");

  config.triggers.forEach(function(t) {
    if (t.time === currentHourMin) {
      var shouldRun = false;
      if (t.freqType === 'daily') shouldRun = true;
      else if (t.freqType === 'weekly' && t.freqValue === currentDayOfWeek) shouldRun = true;
      else if (t.freqType === 'specific_date' && t.freqValue === currentDate) shouldRun = true;

      if (shouldRun) executeLineSummary(t, config);
    }
  });
}

