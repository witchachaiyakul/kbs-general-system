function bulkApproveBookings(month, year, adminUser) {
  try {
    const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(SHEET_NAME);
    if (sheet.getLastRow() < 2) return { success: false, message: 'ไม่พบข้อมูลการจอง' };
    
    const data = sheet.getDataRange().getValues();
    let count = 0;

    for (let i = 1; i < data.length; i++) {
      if (!data[i][6]) continue; // ข้ามถ้าไม่มีวันที่เริ่ม
      
      const bDate = new Date(data[i][6]);
      const mMonth = (!month || month === "") ? true : (bDate.getMonth() + 1) == month;
      const mYear = (!year || year === "") ? true : bDate.getFullYear() == year;

      // ถ้าเดือน/ปี ตรงกับที่เลือก และสถานะปัจจุบันคือ "รออนุมัติ"
      if (mMonth && mYear && data[i][13] === 'รออนุมัติ') {
        sheet.getRange(i + 1, 14).setValue('อนุมัติ'); // อัปเดตชีต
        count++;
        
        // อัปเดตสีใน Google Calendar
        const calendarEventId = data[i][15];
        if (calendarEventId) {
          try {
            const event = CalendarApp.getCalendarById(CALENDAR_ID).getEventById(calendarEventId);
            if (event) event.setColor(CalendarApp.EventColor.GREEN);
          } catch (calErr) {}
        }
      }
    }

    if (count > 0) {
      logAction(adminUser || 'Admin', `อนุมัติทั้งหมดรวดเดียวจำนวน ${count} รายการ (เดือน: ${month||'ทุกเดือน'}/${year||'ทุกปี'})`);
    }

    return { success: true, count: count };
  } catch (e) { 
    return { success: false, message: e.message }; 
  }
}

// ==========================================
// --- ทริกเกอร์แจ้งเตือนรายสัปดาห์ (เพิ่มใหม่สำหรับตั้ง Trigger) ---
// ==========================================
function sendUpcomingRoomUsageFromSheet() {
  // 1. ดึงการตั้งค่า LINE จากระบบปัจจุบัน (เพื่อให้รองรับการสลับ Bot อัตโนมัติ)
  var config = getLineSettings();
  var bot = config.bots.find(function(b) { return b.id == config.activeBotId; }) || config.bots[0];
  var token = bot.token;
  var groupId = config.groupId;

  if (!token || !groupId) {
    Logger.log("ระบบทริกเกอร์: ไม่พบ Token หรือ Group ID ของ LINE");
    return;
  }

  // 2. ดึงข้อมูลจากชีต
  var sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(SHEET_NAME); 
  var dataRange = sheet.getDataRange();
  var values = dataRange.getValues();

  // 3. คำนวณหาวันจันทร์ - อาทิตย์ ของสัปดาห์นี้
  var today = new Date();
  var upcomingMonday = new Date(today.getFullYear(), today.getMonth(), today.getDate() - today.getDay() + 1);
  upcomingMonday.setHours(0, 0, 0, 0);

  var upcomingSunday = new Date(upcomingMonday.getTime());
  upcomingSunday.setDate(upcomingMonday.getDate() + 6);
  upcomingSunday.setHours(23, 59, 59, 999);

  var upcomingUsage = [];

  // 4. วนลูปหาคิวจองที่อยู่ในช่วงสัปดาห์นี้
  for (var i = 1; i < values.length; i++) {
    var row = values[i];
    if (!row[6]) continue; // ถ้าไม่มีข้อมูลเวลาเริ่ม ให้ข้าม

    var startTime = new Date(row[6]); 

    if (startTime >= upcomingMonday && startTime <= upcomingSunday) {
      var status = row[13]; 
      if (status === 'ยกเลิก' || status === 'ไม่อนุมัติ') continue;

      upcomingUsage.push({
        startTime: startTime,
        endTime:   new Date(row[7]),
        location:  row[4],
        fullName:  row[1]
      });
    }
  }

  // 5. เรียงลำดับตามเวลา
  upcomingUsage.sort(function(a, b) {
    return a.startTime - b.startTime;
  });

  var thaiDays = ['อาทิตย์', 'จันทร์', 'อังคาร', 'พุธ', 'พฤหัสบดี', 'ศุกร์', 'เสาร์'];
  
  function formatDateLocal(date) {
    return Utilities.formatDate(date, 'Asia/Bangkok', 'dd/MM/yyyy');
  }
  function formatTimeLocal(date) {
    return Utilities.formatDate(date, 'Asia/Bangkok', 'HH:mm');
  }

  // 6. ประกอบข้อความ
  var messageHeader = '🗓️ แจ้งเตือนการใช้ห้องสัปดาห์นี้\n(' +
                      formatDateLocal(upcomingMonday) + ' - ' + formatDateLocal(upcomingSunday) + '):\n';
  var messageBody = '';

  if (upcomingUsage.length === 0) {
    messageBody = '\nไม่มีการใช้ห้องในสัปดาห์นี้';
  } else {
    upcomingUsage.forEach(function(usage, index) {
      messageBody += '\n' + (index > 0 ? '----------\n' : '');
      messageBody += 'ห้อง: ' + usage.location + '\n' +
                     'วัน: ' + formatDateLocal(usage.startTime) + ' (' + thaiDays[usage.startTime.getDay()] + ')\n' +
                     'เวลา: ' + formatTimeLocal(usage.startTime) + ' - ' + formatTimeLocal(usage.endTime) + '\n' +
                     'ผู้ใช้: ' + usage.fullName;
    });
  }

  var finalMessage = messageHeader + messageBody;
  
  // 7. ส่งข้อความเข้า LINE (โดยใช้ตัวแปรจากระบบใหม่)
  var url = 'https://api.line.me/v2/bot/message/push';
  var payload = { 'to': groupId, 'messages': [{ 'type': 'text', 'text': finalMessage }] };
  var options = {
    'method': 'post',
    'contentType': 'application/json',
    'headers': { 'Authorization': 'Bearer ' + token },
    'payload': JSON.stringify(payload),
    'muteHttpExceptions': true
  };
  UrlFetchApp.fetch(url, options);
}

// ==========================================
// ⚙️ ENGINE สำหรับ Smart Triggers (ทำงานทุก 1 นาที)
// ==========================================
function setupMasterTrigger() {
  const triggers = ScriptApp.getProjectTriggers();
  // ลบทริกเกอร์เช็คเวลาตัวเก่าออกเพื่อป้องกันการทำงานซ้ำซ้อน
  for (let i = 0; i < triggers.length; i++) {
    if (triggers[i].getHandlerFunction() === 'processSmartLineTriggers') {
      ScriptApp.deleteTrigger(triggers[i]);
    }
  }
  
  // สร้างทริกเกอร์ใหม่ ให้เรียกฟังก์ชัน processSmartLineTriggers ทุกๆ 1 นาที
  ScriptApp.newTrigger('processSmartLineTriggers')
    .timeBased()
    .everyMinutes(1)
    .create();
}