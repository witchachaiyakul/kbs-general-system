function getBookings(month, year) {
  const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(SHEET_NAME);
  if (sheet.getLastRow() < 2) return [];
  const values = sheet.getRange(2, 1, sheet.getLastRow() - 1, sheet.getLastColumn()).getValues();
  const filtered = values.filter(row => {
    if (!row[6]) return false;
    const bDate = new Date(row[6]);
    const mMonth = (!month || month === "") ? true : (bDate.getMonth() + 1) == month;
    const mYear = (!year || year === "") ? true : bDate.getFullYear() == year;
    return mMonth && mYear;
  });
  const bookings = filtered.map(row => {
    const exUrl = (cv) => { if (typeof cv === 'string' && cv.startsWith('=HYPERLINK')) { const match = cv.match(/=HYPERLINK\("([^"]+)"/); return match ? match[1] : cv; } return cv; };
    return { timestamp: row[0] ? new Date(row[0]).toISOString() : '', fullName: row[1], position: row[2], phone: row[3], location: row[4], purpose: row[5], startTime: row[6] ? new Date(row[6]).toISOString() : '', endTime: row[7] ? new Date(row[7]).toISOString() : '', equipment: row[8], tables: row[9], chairs: row[10], layoutUrl: exUrl(row[11]), attachmentUrl: exUrl(row[12]), status: row[13], uniqueId: row[14], calendarEventId: row[15] };
  });
  return bookings.reverse();
}

