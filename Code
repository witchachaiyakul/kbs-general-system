function getSystemSettings() {
  const props = PropertiesService.getScriptProperties();
  const rbacDef = { charts: true, backoffice: true, users: true, logs: true, settings: true, line: true };
  let rbac = props.getProperty('sys_rbac');
  if (rbac) { try { rbac = JSON.parse(rbac); } catch(e) { rbac = rbacDef; } } else { rbac = rbacDef; }
  
  let themeIndex = parseInt(props.getProperty('sys_theme_index')) || 0;
  if(themeIndex < 0 || themeIndex >= THEMES.length) themeIndex = 0;
  
  return {
    systemName: props.getProperty('sys_name') || 'ระบบจองห้องประชุม\nโรงเรียนกาญจนาภิเษกวิทยาลัย กระบี่',
    logoUrl: props.getProperty('sys_logo') || 'https://img2.pic.in.th/pic/PNG-cc2fe0af0f6d0d30.png',
    themeIndex: themeIndex,
    theme: THEMES[themeIndex],
    rbac: rbac
  };
}

