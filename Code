function submitBooking(formData) {
  try {
    if (formData.Location !== 'อื่นๆ' && formData.Location.includes(' รองรับ')) { formData.Location = formData.Location.split(' รองรับ')[0].trim(); }
    const startTime = new Date(formData.StartTime);
    const endTime = new Date(formData.EndTime);
    const room = formData.Location === 'อื่นๆ' ? formData.LocationOther : formData.Location;
    
    if (isTimeBlocked(startTime, endTime, room)) { throw new Error('ระบบปิดรับการจองในช่วงเวลาหรือห้องที่ท่านเลือก กรุณาติดต่อผู้ดูแลระบบ'); }
    
    const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(SHEET_NAME);
    const calendar = CalendarApp.getCalendarById(CALENDAR_ID);
    
    const exceptBookingId = formData.BookingId || null;
    if (checkForConflictsStrict(sheet, room, startTime, endTime, exceptBookingId)) { throw new Error('วันและเวลาดังกล่าวมีการจองแล้ว กรุณาเลือกช่วงเวลาอื่นหรือติดต่อฝ่ายบริหารทั่วไป'); }
    
    const uniqueId = Utilities.getUuid();
    let layoutUrl = ''; let attachmentUrl = '';
    if (formData.LayoutFile && formData.LayoutFile.bytes) { layoutUrl = uploadFileToDrive(formData.LayoutFile, `Layout_${formData.FullName}_${uniqueId}`); }
    if (formData.AttachmentFile && formData.AttachmentFile.bytes) { attachmentUrl = uploadFileToDrive(formData.AttachmentFile, `Attachment_${formData.FullName}_${uniqueId}`); }
    
    const eventTitle = `${room} - ${formData.FullName}`;
    const eventDescription = `วัตถุประสงค์: ${formData.Purpose}\nตำแหน่ง: ${formData.Position === 'อื่นๆ' ? formData.PositionOther : formData.Position}\nโทรศัพท์: ${formData.Phone}\nอุปกรณ์ที่ขอใช้: ${Array.isArray(formData.Equipment) ? formData.Equipment.join(', ') : (formData.Equipment || '')}\nโต๊ะ: ${formData.Tables} ตัว\nเก้าอี้: ${formData.Chairs} ตัว`.trim();
    const event = calendar.createEvent(eventTitle, startTime, endTime, { description: eventDescription });
    
    const newRow = [new Date(), formData.FullName, formData.Position === 'อื่นๆ' ? formData.PositionOther : formData.Position, formData.Phone, room, formData.Purpose, startTime, endTime, Array.isArray(formData.Equipment) ? formData.Equipment.join(', ') : (formData.Equipment || ''), formData.Tables, formData.Chairs, layoutUrl, attachmentUrl, 'รออนุมัติ', uniqueId, event.getId()];
    sheet.appendRow(newRow);
    sendLineNotification(formData, layoutUrl, attachmentUrl);
    return { success: true, message: 'บันทึกข้อมูลการจองเรียบร้อยแล้ว' };
  } catch (error) { Logger.log(error.toString()); return { success: false, message: error.message }; }
}

function checkForConflictsStrict(sheet, room, startTime, endTime, exceptBookingId) {
  const data = sheet.getDataRange().getValues();
  if (data.length <= 1) return false;
  const COL_ROOM = 5, COL_START = 7, COL_END = 8, COL_STATUS = 14, COL_BOOKING_ID = 15;
  const A1 = normalizeToDate(startTime), A2 = normalizeToDate(endTime);
  for (let i = 1; i < data.length; i++) {
    const row = data[i];
    const rRoom = (row[COL_ROOM - 1] || '').toString().trim();
    if (rRoom !== room) continue;
    const status = (row[COL_STATUS - 1] || '').toString().trim();
    if (status === 'ยกเลิก' || status === 'ไม่อนุมัติ') continue;
    const rBookingId = (row[COL_BOOKING_ID - 1] || '').toString().trim();
    if (exceptBookingId && rBookingId && rBookingId === String(exceptBookingId)) continue;
    const B1 = normalizeToDate(row[COL_START - 1]), B2 = normalizeToDate(row[COL_END - 1]);
    if (isOverlap(A1, A2, B1, B2)) return true;
  }
  return false;
}

function isOverlap(aStart, aEnd, bStart, bEnd) {
  const A1 = normalizeToDate(aStart).getTime(), A2 = normalizeToDate(aEnd).getTime();
  const B1 = normalizeToDate(bStart).getTime(), B2 = normalizeToDate(bEnd).getTime();
  if (!(A1 < A2 && B1 < B2)) return false;
  return A1 < B2 && B1 < A2;
}

function normalizeToDate(v) {
  if (v instanceof Date) return v;
  if (typeof v === 'number') return new Date(Math.round((v - 25569) * 86400 * 1000));
  return new Date(v);
}

function checkForConflicts(location, startTime, endTime, excludeUniqueId) {
  const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(SHEET_NAME);
  if (sheet.getLastRow() < 2) return false;
  const data = sheet.getRange(2, 1, sheet.getLastRow() - 1, sheet.getLastColumn()).getValues();
  const locationCol = 4, startCol = 6, endCol = 7, statusCol = 13, uniqueIdCol = 14;
  if (location.startsWith('อื่นๆ')) return false;
  for (let i = 0; i < data.length; i++) {
    const row = data[i];
    if (row[statusCol] === 'ไม่อนุมัติ' || row[statusCol] === 'ยกเลิก' || (excludeUniqueId && row[uniqueIdCol] === excludeUniqueId)) continue;
    if (row[locationCol] === location && startTime < new Date(row[endCol]) && endTime > new Date(row[startCol])) return true;
  }
  return false;
}

