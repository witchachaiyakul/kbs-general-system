function getRoomsData() {
  const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
  let sheet = ss.getSheetByName('Rooms');
  if (!sheet) {
    sheet = ss.insertSheet('Rooms');
    sheet.appendRow(['RoomName', 'Capacity']);
    const defaults = [['หอประชุม', '1500'], ['โดมราชพฤกษ์', '3000'], ['ห้องประชุม Auditorium', '100'], ['ห้องประชุมราชพฤกษ์', '30'], ['ห้องทูบี', '200'], ['ห้องสมาคมผู้ปกครองและครู', '30'], ['ห้องประชุมช่อราชพฤกษ์', '180']];
    defaults.forEach(r => sheet.appendRow(r));
  }
  const data = sheet.getDataRange().getValues();
  const rooms = [];
  for (let i = 1; i < data.length; i++) {
    if(data[i][0]) rooms.push({ rowNum: i+1, name: data[i][0].toString(), capacity: data[i][1].toString() });
  }
  return rooms;
}

function saveRoom(room, adminUser) {
  try {
    const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName('Rooms');
    if (room.isNew) {
      sheet.appendRow([room.name, room.capacity]);
      logAction(adminUser || 'Admin', `เพิ่มห้องประชุมใหม่: ${room.name}`);
    } else {
      sheet.getRange(parseInt(room.rowNum), 1).setValue(room.name);
      sheet.getRange(parseInt(room.rowNum), 2).setValue(room.capacity);
      logAction(adminUser || 'Admin', `แก้ไขข้อมูลห้องประชุม: ${room.name}`);
